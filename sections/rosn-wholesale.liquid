{%- comment -%} O's by ROSN — wholesale inquiry intro (pairs with contact-form below) {%- endcomment -%}
<div class="rosn-wholesale color-{{ section.settings.color_scheme }} rosn-section">
  <header class="rosn-wrap rosn-page-hero">
    <p class="rosn-kicker rosn-kicker--center">{{ section.settings.kicker }}</p>
    <h1 class="rosn-display" data-reveal="up">{{ section.settings.title }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="rosn-wholesale__sub" data-reveal="up" data-reveal-delay="0.1">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </header>

  {%- if section.blocks.size > 0 -%}
    <div class="rosn-wrap rosn-wholesale__points" data-reveal-group>
      {%- for block in section.blocks -%}
        <div class="rosn-wholesale__point" data-reveal-child {{ block.shopify_attributes }}>
          <span class="rosn-wholesale__num rosn-gold-text">{{ forloop.index }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="rosn-wrap"><p class="rosn-wholesale__cue" data-reveal="fade">{{ section.settings.form_cue }}</p></div>
</div>

{%- style -%}
  .rosn-wholesale { padding-bottom: 0; }
  .rosn-wholesale__sub { margin: 2.4rem auto 0; max-width: 60rem; color: var(--rosn-ink-dim); font-size: 1.7rem; }
  .rosn-wholesale__points { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: clamp(3rem,5vw,5rem); }
  .rosn-wholesale__point { padding: 3rem 2.4rem; border: 1px solid rgba(232,182,76,0.16); border-radius: 4px; background: rgba(255,255,255,0.015); }
  .rosn-wholesale__num { font-family: var(--rosn-font-serif); font-size: 3.4rem; display: block; margin-bottom: 1.2rem; }
  .rosn-wholesale__point h3 { font-family: var(--rosn-font-serif); font-size: 2.2rem; margin: 0 0 0.8rem; }
  .rosn-wholesale__point p { color: var(--rosn-ink-dim); font-size: 1.5rem; line-height: 1.6; margin: 0; }
  .rosn-wholesale__cue { text-align: center; margin: clamp(4rem,7vw,7rem) auto 0; color: var(--rosn-gold); text-transform: uppercase; letter-spacing: 0.28em; font-size: 1.2rem; }
  @media (max-width: 749px) { .rosn-wholesale__points { grid-template-columns: 1fr; } }
{%- endstyle -%}

{% schema %}
{
  "name": "ROSN — Wholesale intro",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Wholesale" },
    { "type": "text", "id": "title", "label": "Title", "default": "Request a wholesale account" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Tell us about your business and a member of the Joon Distribution team will be in touch with pricing and terms." },
    { "type": "text", "id": "form_cue", "label": "Cue above form", "default": "Complete the form below ↓" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Compliant by design" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "No nicotine, hemp, THC, or cannabinoids — easy to stock with confidence." }
      ]
    }
  ],
  "presets": [
    {
      "name": "ROSN — Wholesale intro",
      "blocks": [
        { "type": "point", "settings": { "heading": "Compliant by design", "body": "No nicotine, hemp, THC, or cannabinoids — easy to stock with confidence." } },
        { "type": "point", "settings": { "heading": "Three proven strains", "body": "Maui Waui, Biscotti, and Açaí Gelato — 600 solventless puffs each." } },
        { "type": "point", "settings": { "heading": "Backed by Joon", "body": "Reliable wholesale fulfillment and support out of Austin, TX." } }
      ]
    }
  ]
}
{% endschema %}
