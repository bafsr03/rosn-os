{%- comment -%} O's by ROSN — cinematic hero {%- endcomment -%}
{%- liquid
  assign mark = section.settings.mark_image
-%}

<div class="rosn-hero color-{{ section.settings.color_scheme }} rosn-section" data-parallax-scope>
  <canvas class="rosn-hero__smoke" data-rosn-smoke aria-hidden="true"></canvas>
  <div class="rosn-hero__glow" aria-hidden="true"></div>

  <div class="rosn-wrap rosn-hero__inner">
    {%- if section.settings.kicker != blank -%}
      <p class="rosn-kicker rosn-kicker--center rosn-hero__kicker" data-reveal="fade">{{ section.settings.kicker }}</p>
    {%- endif -%}

    <div class="rosn-hero__mark" data-reveal="scale" data-reveal-delay="0.1">
      {%- if mark != blank -%}
        <img src="{{ mark | image_url: width: 900 }}" alt="{{ shop.name }}" width="900" height="600" loading="eager" fetchpriority="high">
      {%- else -%}
        <img src="{{ 'rosn-os-mark.png' | asset_url }}" alt="O's by ROSN" width="900" height="600" loading="eager" fetchpriority="high">
      {%- endif -%}
    </div>

    {%- if section.settings.title != blank -%}
      <h1 class="rosn-wide rosn-hero__title" data-reveal="up" data-reveal-delay="0.2">{{ section.settings.title }}</h1>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="rosn-hero__sub" data-reveal="up" data-reveal-delay="0.3">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="rosn-hero__cta" data-reveal="up" data-reveal-delay="0.4">
        <a href="{{ section.settings.button_link | default: '#' }}" class="rosn-btn rosn-magnetic" data-magnetic="0.4">
          {{ section.settings.button_label }}
          <span class="rosn-btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    {%- endif -%}
  </div>

  <div class="rosn-hero__scroll" aria-hidden="true">
    <span>Scroll</span>
    <span class="rosn-hero__scroll-line"></span>
  </div>
</div>

{%- style -%}
  .rosn-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
    isolation: isolate;
    background: radial-gradient(120% 90% at 50% 30%, #17100f 0%, #0a0708 62%);
  }
  .rosn-hero__smoke { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
  .rosn-hero__glow {
    position: absolute; left: 50%; top: 42%; transform: translate(-50%, -50%);
    width: min(80vw, 70rem); height: min(80vw, 70rem);
    background: radial-gradient(circle, rgba(232,182,76,0.16), transparent 62%);
    z-index: 0; pointer-events: none;
  }
  .rosn-hero__inner { position: relative; padding-block: 12rem 8rem; }
  .rosn-hero__kicker { margin-bottom: 3rem; }
  .rosn-hero__mark { margin: 0 auto 2rem; width: min(78vw, 52rem); }
  .rosn-hero__mark img {
    width: 100%; height: auto; display: block;
    mix-blend-mode: screen;
    -webkit-mask-image: radial-gradient(ellipse 62% 62% at 50% 50%, #000 50%, transparent 76%);
    mask-image: radial-gradient(ellipse 62% 62% at 50% 50%, #000 50%, transparent 76%);
    animation: rosn-float 7s ease-in-out infinite;
  }
  .rosn-hero__title { color: var(--rosn-magenta); letter-spacing: 0.28em; font-size: clamp(1.8rem, 3vw, 3rem); }
  .rosn-hero__sub {
    margin: 1.6rem auto 0; max-width: 52rem;
    text-transform: uppercase; letter-spacing: 0.34em;
    font-size: clamp(1rem, 1.3vw, 1.35rem); color: var(--rosn-ink-dim);
  }
  .rosn-hero__cta { margin-top: 4rem; }
  .rosn-hero__scroll {
    position: absolute; bottom: 3rem; left: 50%; transform: translateX(-50%);
    z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 1rem;
    text-transform: uppercase; letter-spacing: 0.3em; font-size: 1rem; color: var(--rosn-ink-faint);
  }
  .rosn-hero__scroll-line { width: 1px; height: 5rem; background: linear-gradient(var(--rosn-gold), transparent); position: relative; overflow: hidden; }
  .rosn-hero__scroll-line::after {
    content: ""; position: absolute; top: -50%; left: 0; width: 100%; height: 50%;
    background: var(--rosn-gold-hi); animation: rosn-scrolldot 2.2s var(--rosn-ease) infinite;
  }
  @keyframes rosn-float { 0%,100% { transform: translateY(0) rotate(-1deg); } 50% { transform: translateY(-14px) rotate(1deg); } }
  @keyframes rosn-scrolldot { 0% { top: -50%; } 100% { top: 150%; } }
  @media (prefers-reduced-motion: reduce) {
    .rosn-hero__mark img { animation: none; }
    .rosn-hero__scroll-line::after { animation: none; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "ROSN — Hero",
  "tag": "section",
  "class": "section rosn-full",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Elevated by ROSN" },
    { "type": "image_picker", "id": "mark_image", "label": "Brand mark (defaults to O's logo)" },
    { "type": "text", "id": "title", "label": "Title line", "default": "Flavor Collection" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "600 Solventless · Invisible · Elevated Puffs" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request Wholesale" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "ROSN — Hero" }]
}
{% endschema %}
