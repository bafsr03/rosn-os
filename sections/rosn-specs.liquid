{%- comment -%} O's by ROSN — What's inside / How it works + stats {%- endcomment -%}
<div class="rosn-specs color-{{ section.settings.color_scheme }} rosn-section">
  <div class="rosn-wrap">
    <div class="rosn-specs__cols">
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div class="rosn-specs__col" data-reveal="up" {{ block.shopify_attributes }}>
            <h3 class="rosn-specs__h">{{ block.settings.heading }}</h3>
            <ul class="rosn-specs__list" role="list">
              {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign l = line | strip -%}
                {%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- assign stats = section.blocks | where: 'type', 'stat' -%}
    {%- if stats.size > 0 -%}
      <div class="rosn-rule"></div>
      <div class="rosn-specs__stats" data-reveal-group>
        {%- for block in stats -%}
          <div class="rosn-stat rosn-specs__stat" data-reveal-child {{ block.shopify_attributes }}>
            <div class="rosn-stat__num rosn-gold-text">
              {%- if block.settings.animate and block.settings.number != blank -%}
                <span data-count="{{ block.settings.number }}" data-count-suffix="{{ block.settings.suffix }}">0{{ block.settings.suffix }}</span>
              {%- else -%}
                {{ block.settings.number }}{{ block.settings.suffix }}
              {%- endif -%}
            </div>
            <div class="rosn-stat__label">{{ block.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .rosn-specs { padding-block: clamp(6rem, 10vw, 12rem); }
  .rosn-specs__cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(3rem, 6vw, 8rem); }
  .rosn-specs__h {
    font-family: var(--rosn-font-body); text-transform: uppercase; letter-spacing: 0.22em;
    font-size: clamp(1.4rem, 1.6vw, 1.7rem); color: var(--rosn-gold); margin: 0 0 2.4rem;
    padding-bottom: 1.4rem; border-bottom: 1px solid rgba(232,182,76,0.2);
  }
  .rosn-specs__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.4rem; }
  .rosn-specs__list li { position: relative; padding-left: 2.4rem; color: var(--rosn-ink-dim); font-size: 1.6rem; line-height: 1.5; }
  .rosn-specs__list li::before { content: "—"; position: absolute; left: 0; color: var(--rosn-gold); }
  .rosn-specs__stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; text-align: center; }
  .rosn-specs__stat { padding: 2rem; }
  @media (max-width: 749px) {
    .rosn-specs__cols { grid-template-columns: 1fr; }
    .rosn-specs__stats { grid-template-columns: 1fr; gap: 3rem; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "ROSN — Specs",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "What's Inside" },
        { "type": "textarea", "id": "items", "label": "Items (one per line)", "default": "All natural flavors\nFood-grade PG & VG base\nOur priority engineered molecular compound" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "600" },
        { "type": "text", "id": "suffix", "label": "Suffix" },
        { "type": "text", "id": "label", "label": "Label", "default": "Puffs" },
        { "type": "checkbox", "id": "animate", "label": "Count up", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "ROSN — Specs",
      "blocks": [
        { "type": "column", "settings": { "heading": "What's Inside", "items": "All natural flavors\nFood-grade PG & VG base\nOur priority engineered molecular compound" } },
        { "type": "column", "settings": { "heading": "How It Works", "items": "Remove device from packaging\nPeel the protective sticker from the base\nRemove the silicone plug from the mouthpiece\nInhale directly to activate — no buttons, no charging\nFully disposable once finished" } },
        { "type": "stat", "settings": { "number": "2", "suffix": "mL", "label": "Capacity", "animate": false } },
        { "type": "stat", "settings": { "number": "600", "suffix": "", "label": "Puffs", "animate": true } },
        { "type": "stat", "settings": { "number": "18", "suffix": "+", "label": "Age Restricted", "animate": false } }
      ]
    }
  ]
}
{% endschema %}
