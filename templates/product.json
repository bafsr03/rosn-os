{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": { "type": "text", "settings": { "text": "{{ product.vendor }}", "text_style": "uppercase" } },
        "title": { "type": "title", "settings": {} },
        "description": { "type": "description", "settings": {} },
        "contact_rep": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"rosn-product-cta\"><p class=\"rosn-product-cta__note\">Available online soon. To stock O's or place a wholesale order, talk to a representative.</p><a href=\"/pages/wholesale\" class=\"rosn-btn rosn-magnetic\" data-magnetic=\"0.3\">Talk to a representative <span class=\"rosn-btn__arrow\" aria-hidden=\"true\">&rarr;</span></a></div>{% style %}.rosn-product-cta{margin-top:2.4rem}.rosn-product-cta__note{color:var(--rosn-ink-dim);font-size:1.55rem;line-height:1.6;margin:0 0 1.8rem;max-width:44rem}{% endstyle %}"
          }
        },
        "share": { "type": "share", "settings": { "share_label": "Share" } }
      },
      "block_order": ["vendor", "title", "description", "contact_rep", "share"],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "stacked",
        "mobile_thumbnails": "hide",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 40,
        "padding_bottom": 0
      }
    },
    "disclosures": { "type": "disclosures", "settings": { "padding_top": 36, "padding_bottom": 0 } }
  },
  "order": ["main", "disclosures"]
}
